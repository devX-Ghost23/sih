# Optional convenience wrapper for macOS/Linux.
# Everything here also works on Windows as:  python tw.py <task>
PY ?= python3

.PHONY: up demo ingest classify train evaluate test logs down setup-local

up:            ; $(PY) tw.py up
demo:          ; $(PY) tw.py demo
ingest:        ; $(PY) tw.py ingest
classify:      ; $(PY) tw.py classify
train:         ; $(PY) tw.py train
evaluate:      ; $(PY) tw.py evaluate
test:          ; $(PY) tw.py test
logs:          ; $(PY) tw.py logs
down:          ; $(PY) tw.py down
setup-local:   ; $(PY) tw.py setup-local
