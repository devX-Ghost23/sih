# Local development overrides
# Copy this to .env.local and adjust values.

# Run the frontend with deterministic mock data (no backend required).
NEXT_PUBLIC_USE_MOCK_DATA=true

# When running with a real backend, set these and flip USE_MOCK_DATA to false:
# BACKEND_API_URL=http://localhost:8000/api
# NEXT_PUBLIC_MAP_TILE_URL=
